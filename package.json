{
  "name": "gladys-groq",
  "version": "0.1.0",
  "private": true,
  "description": "External Gladys Assistant integration that runs the Gladys AI assistant on Groq (GPT-OSS, Qwen on very fast LPU chips) with your own API key: chat, router, weekly digest, browser search scene action, usage widget.",
  "homepage": "https://github.com/William-De71/gladys-groq",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-De71/gladys-groq.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0",
  "keywords": [
    "gladys-assistant",
    "gladys-assistant-integration",
    "groq",
    "gpt-oss",
    "llm",
    "ai",
    "assistant",
    "home-automation"
  ]
}
